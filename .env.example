# =====================================================================
#  Aula Virtual LPR — Variables de entorno
#  Copia este archivo:   cp .env.example .env   y completa tus valores.
#  .env NUNCA se sube a GitHub (esta en .gitignore).
# =====================================================================

# ---------- PostgreSQL (lo usan auth-python, clases-java y notificaciones-go)
DB_USER=admin
DB_PASS=supersecreta
DB_NAME=aula
DB_HOST=postgres
DB_PORT=5432

# Cada microservicio tiene su propia base de datos dentro del mismo Postgres
DATABASE_URL_AUTH=postgresql://admin:supersecreta@postgres:5432/auth_db
DATABASE_URL_CLASES=jdbc:postgresql://postgres:5432/clases_db
DATABASE_URL_NOTIF=host=postgres user=admin password=supersecreta dbname=notif_db port=5432 sslmode=disable

# ---------- MongoDB (lo usa ia-node)
MONGO_URL=mongodb://mongodb:27017/aula_ia

# ---------- Seguridad
# Clave para firmar los JWT. La comparten los 4 servicios. Cambiala por algo largo y aleatorio.
SECRET_KEY=cambia-esta-clave-por-una-muy-larga-y-aleatoria-1234567890
# Token para llamadas internas entre microservicios (no pasa por el navegador)
INTERNAL_TOKEN=token-interno-cambiame

# Administrador general: se crea al arrancar por primera vez (ya verificado). Aprueba a los
# profesores que se registran. Los demas usuarios se registran solos desde la web.
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@ujap.edu.ve
ADMIN_PASSWORD=Admin2026!

# ---------- Inteligencia Artificial
# Proveedor: nvidia (por defecto) o gemini
IA_PROVIDER=nvidia

# NVIDIA NIM — key gratis en https://build.nvidia.com  (boton "Get API Key", empieza con nvapi-)
NVIDIA_API_KEY=
NVIDIA_MODEL=google/gemma-4-31b-it

# Google Gemini (alternativa) — key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Institucion que la IA menciona como contexto (opcional). La materia NO va aqui: cada clase
# le pasa a la IA la suya (nombre, codigo y descripcion), asi sirve para cualquier profesor y materia.
INSTITUCION=Universidad Jose Antonio Paez, Venezuela

# Si la key del proveedor elegido esta VACIA el sistema funciona en "modo demo"
# con contenido de ejemplo, para que siempre se pueda evaluar.

# Minutos que dura un codigo de verificacion enviado por correo
CODIGO_EXPIRA_MIN=10

# ---------- Correo (SMTP)
# Por defecto los correos van a Mailpit, una bandeja de prueba: el codigo de verificacion
# se lee en http://localhost:8025 y no hay que configurar nada para evaluar el sistema.
# NO se pone aqui ninguna cuenta real: este archivo es publico y una clave SMTP publicada
# permite a cualquiera enviar correos como esa cuenta. Para correo real con Gmail, escribe
# estos valores solo en tu .env (que no se sube a git):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=tucorreo@gmail.com
#   SMTP_PASS=<contrasena de aplicacion de 16 letras, sin espacios>
#   SMTP_FROM=Aula Virtual LPR <tucorreo@gmail.com>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Aula Virtual LPR <aula@ujap.edu.ve>

# URL publica del sistema (se usa en los enlaces de los correos)
PUBLIC_URL=https://localhost
