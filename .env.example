# =====================================================================
#  Aula Virtual LPR — Variables de entorno
#  Copia este archivo:   cp .env.example .env   y completa tus valores.
#  .env NUNCA se sube a GitHub (esta en .gitignore).
# =====================================================================

# ---------- PostgreSQL (lo usan auth-python, clases-java y notificaciones-go)
DB_USER=admin
DB_PASS=supersecreta
DB_NAME=aula
DB_HOST=postgres
DB_PORT=5432

# Cada microservicio tiene su propia base de datos dentro del mismo Postgres
DATABASE_URL_AUTH=postgresql://admin:supersecreta@postgres:5432/auth_db
DATABASE_URL_CLASES=jdbc:postgresql://postgres:5432/clases_db
DATABASE_URL_NOTIF=host=postgres user=admin password=supersecreta dbname=notif_db port=5432 sslmode=disable

# ---------- MongoDB (lo usa ia-node)
MONGO_URL=mongodb://mongodb:27017/aula_ia

# ---------- Seguridad
# Clave para firmar los JWT. La comparten los 4 servicios. Cambiala por algo largo y aleatorio.
SECRET_KEY=cambia-esta-clave-por-una-muy-larga-y-aleatoria-1234567890
# Token para llamadas internas entre microservicios (no pasa por el navegador)
INTERNAL_TOKEN=token-interno-cambiame

# Usuario profesora que se crea al arrancar por primera vez
ADMIN_NOMBRE=Maria Valentina Garcia
ADMIN_EMAIL=profesora@ujap.edu.ve
ADMIN_PASSWORD=Profe2026!

# ---------- Inteligencia Artificial (Google Gemini)
# Consigue tu key gratis en https://aistudio.google.com/apikey
# Si la dejas VACIA el sistema funciona en "modo demo" con contenido de ejemplo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- Correo (SMTP)
# Por defecto usa Mailpit (bandeja de prueba en http://localhost:8025).
# Para correo real con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=tucorreo@gmail.com, SMTP_PASS=<contrasena de aplicacion>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Aula Virtual LPR <aula@ujap.edu.ve>

# URL publica del sistema (se usa en los enlaces de los correos)
PUBLIC_URL=http://localhost
